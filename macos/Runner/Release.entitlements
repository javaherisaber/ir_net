<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- No App Sandbox: the V2Ray VPN runs the bundled Xray core and changes the
     system proxy (networksetup), which the sandbox forbids. IRNet ships as a
     DMG, not through the App Store. Settings and history from the sandboxed
     builds are moved over on first launch (lib/utils/macos_migration.dart). -->
<dict/>
</plist>

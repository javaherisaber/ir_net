// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = IRNet

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.example.irNet

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2023 com.example. All rights reserved.

// Signing style for the app target (moved here from the project file so the
// optional Signing.xcconfig below can switch it to Manual).
CODE_SIGN_STYLE = Automatic

// Optional local code signing (git-ignored), e.g.
//   CODE_SIGN_STYLE = Manual
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team id>
// Without it the app is signed ad-hoc, and macOS won't let IRNet post its own
// notifications: they fall back to AppleScript and show as "Script Editor".
#include? "Signing.xcconfig"
